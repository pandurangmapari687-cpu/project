<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Plants List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar / Navbar -->
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Plants List</h2>

      <a href="/admin/plants" class="btn btn-violet mb-3">Add New Plant</a>

      <table class="table table-bordered table-striped">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Address</th>
            <th>Date</th>
            <th>Image</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (plants && plants.length) { %>
            <% plants.forEach((p, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= p.name %></td>
                <td><%= p.email %></td>
                <td><%= p.mobile %></td>
                <td><%= p.address %></td>
                <td><%= p.date ? p.date.toISOString().slice(0,10) : '' %></td>
                <td>
                  <% if (p.image) { %>
                    <img src="/uploads/<%= p.image %>" width="50">
                  <% } %>
                </td>
                <td>
                  <a href="/admin/plants/edit/<%= p.plant_id %>" class="btn btn-sm btn-primary">Edit</a>
                  <a href="/admin/plants/delete/<%= p.plant_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this plant?')">Delete</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center text-muted">No plants found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
