<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>About - Admin</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/admin.css" rel="stylesheet">
</head>
<body>
	<div class="d-flex">
		<%- include('./navbar') %>

		<main class="flex-grow-1 p-4" style="margin-left:260px;">
			<h2 class="mb-4">About Page</h2>

			<div class="card violet-main">
				<div class="card-body">
					<form action="/admin/about" method="POST" enctype="multipart/form-data">
						<input type="hidden" name="old_background" value="<%= about ? about.background : '' %>">

						<div class="mb-3">
							<label class="form-label">Title</label>
							<input type="text" name="title" class="form-control" value="<%= about ? about.title : '' %>" required>
						</div>

						<div class="mb-3">
							<label class="form-label">Background Image</label>
							<% if (about && about.background) { %>
								<div class="mb-2">
									<img src="/uploads/<%= about.background %>" alt="background" style="max-width:300px; height:auto;" />
								</div>
							<% } %>
							<input type="file" name="backgroundImage" class="form-control">
						</div>

						<div class="mb-3">
							<label class="form-label">Description</label>
							<textarea name="description" class="form-control" rows="5" required><%= about ? about.description : '' %></textarea>
						</div>

						<div class="mb-3">
							<label class="form-label">Name</label>
							<input type="text" name="name" class="form-control" value="<%= about ? about.name : '' %>">
						</div>

						<button class="btn btn-violet">Save</button>
						<a href="/admin" class="btn btn-secondary ms-2">Cancel</a>
					</form>
				</div>
			</div>

		</main>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>



