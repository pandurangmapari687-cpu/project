<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>About List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-5">
    <h2 class="mb-4 text-center"><i class="fas fa-info-circle"></i> About List</h2>

    <div class="mb-3 text-end">
      <a href="/admin/about" class="btn btn-success"><i class="fas fa-plus"></i> Add About</a>
    </div>

    <table class="table table-bordered table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Title</th>
          <th>Background</th>
          <th>Description</th>
          <th>Name</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (abouts && abouts.length > 0) { %>
          <% abouts.forEach((item) => { %>
            <tr>
              <td><%= item.about_id %></td>
              <td><%= item.title %></td>
              <td>
                <% if(item.background) { %>
                  <img src="/uploads/<%= item.background %>" alt="Background" width="100">
                <% } else { %>
                  No Image
                <% } %>
              </td>
              <td><%= item.description %></td>
              <td><%= item.name %></td>
              <td>
                <a href="/admin/about_edit/<%= item.about_id %>" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                <a href="/admin/about_delete/<%= item.about_id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center text-muted">No records found</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
