<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Contact List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>

<div class="d-flex">
  <!-- Sidebar -->
  <%- include('./navbar') %>

  <main class="flex-grow-1 p-4" style="margin-left:260px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Contact List</h2>
      <a href="/admin/contact" class="btn btn-violet">+ Add New Contact</a>
    </div>

    <div class="card violet-main shadow">
      <div class="card-body table-responsive">
        <table class="table table-bordered table-hover align-middle text-center">
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Number</th>
              <th>Mobile</th>
              <th>Address</th>
              <th>Image</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if (contacts && contacts.length) { %>
              <% contacts.forEach((c, i) => { %>
                <tr>
                  <td><%= c.contact_id %></td>
                  <td><%= c.name %></td>
                  <td><%= c.email %></td>
                  <td><%= c.number %></td>
                  <td><%= c.mobile %></td>
                  <td><%= c.address %></td>
                  <td>
                    <% if (c.image) { %>
                      <img src="/uploads/<%= c.image %>" alt="contact" width="60" height="60" class="rounded-circle border">
                    <% } else { %>
                      <span class="text-muted">No Image</span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/admin/contact/edit/<%= c.contact_id %>" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/admin/contact/delete/<%= c.contact_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this contact?')">Delete</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-4">No contacts found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
