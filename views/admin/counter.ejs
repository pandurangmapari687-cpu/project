<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Counters</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Custom colors */
    .btn-violet {
      background-color: #7c2bd6;
      color: #fff;
    }
    .btn-violet:hover {
      background-color: #5a1eb8;
      color: #fff;
    }
    .card {
      border-radius: 8px;
    }
    .card-body h5 {
      margin-bottom: 0.5rem;
    }
    main {
      margin-left: 260px; /* sidebar width */
    }
  </style>
</head>
<body>
  <div class="d-flex">
    <!-- Include Navbar / Sidebar -->
    <%- include('./navbar') %>

    <!-- Main Content -->
    <main class="flex-grow-1 p-4">
      <h2 class="mb-4">Counters</h2>

      <!-- Create Counter Form -->
      <div class="card mb-4">
        <div class="card-body">
          <form action="/admin/counter" method="POST">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Name</label>
                <input type="text" name="name" class="form-control" required>
              </div>
              <div class="col-md-2">
                <label class="form-label">Initial Value</label>
                <input type="number" name="value" class="form-control" value="0">
              </div>
              <div class="col-md-2">
                <label class="form-label">Color</label>
                <input type="color" name="color" class="form-control form-control-color" value="#7c2bd6">
              </div>
              <div class="col-md-2">
                <label class="form-label">Step +</label>
                <input type="number" name="step_inc" class="form-control" value="1">
              </div>
              <div class="col-md-2">
                <label class="form-label">Step -</label>
                <input type="number" name="step_dec" class="form-control" value="1">
              </div>
              <div class="col-12">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="3"></textarea>
              </div>
              <div class="col-12 text-end">
                <button type="submit" class="btn btn-violet">Create Counter</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Counters List -->
      <div class="row">
        <% if (counters && counters.length) { %>
          <% counters.forEach(counter => { %>
            <div class="col-md-4 mb-3">
              <div class="card">
                <div class="card-body">
                  <h5 style="color: <%= counter.color %>;"><%= counter.name %></h5>
                  <p class="display-6"><strong><%= counter.value %></strong></p>
                  <p><%= counter.description %></p>
                  <div class="d-flex gap-2">
                    <a href="/admin/counter/increase/<%= counter.id %>" class="btn btn-sm btn-violet">Increase</a>
                    <a href="/admin/counter/decrease/<%= counter.id %>" class="btn btn-sm btn-outline-secondary">Decrease</a>
                    <a href="/admin/counter/delete/<%= counter.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this counter?')">Delete</a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center text-muted">No counters yet</div>
        <% } %>
      </div>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
