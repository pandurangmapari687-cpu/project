<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Contact</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Edit Contact</h2>

      <div class="card violet-main">
        <div class="card-body">
          <form action="/admin/contact/edit/<%= contact.contact_id %>" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input type="text" name="name" class="form-control" value="<%= contact.name %>" required>
              </div>

              <div class="col-md-6">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" value="<%= contact.email %>" required>
              </div>

              <div class="col-md-6">
                <label class="form-label">Phone Number</label>
                <input type="tel" name="number" class="form-control" value="<%= contact.number %>" required>
              </div>

              <div class="col-md-6">
                <label class="form-label">Mobile</label>
                <input type="tel" name="mobile" class="form-control" value="<%= contact.mobile || '' %>">
              </div>

              <div class="col-12">
                <label class="form-label">Address</label>
                <textarea name="address" class="form-control" rows="3" required><%= contact.address %></textarea>
              </div>

              <div class="col-12">
                <label class="form-label">Current Image</label>
                <% if (contact.image) { %>
                  <div class="mb-2">
                    <img src="/uploads/<%= contact.image %>" alt="Contact Image" style="max-width: 200px; max-height: 150px; object-fit: cover; border-radius: 8px;">
                  </div>
                <% } else { %>
                  <div class="text-muted">No image uploaded</div>
                <% } %>
              </div>

              <div class="col-12">
                <label class="form-label">Replace Image (optional)</label>
                <input type="file" name="image" class="form-control" accept="image/*">
                <input type="hidden" name="old_image" value="<%= contact.image || '' %>">
                <small class="text-muted">Leave empty to keep current image</small>
              </div>

              <div class="col-12 text-end">
                <a href="/admin/contact_list" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-violet">Save Changes</button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
