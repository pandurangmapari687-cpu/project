
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5">
  <h2>Edit Machine</h2>
  <form action="/admin/update_machine/<%= machine.machine_id %>" method="post" enctype="multipart/form-data">
    
    <div class="mb-3">
      <label for="machine_name" class="form-label">Machine Name</label>
      <input type="text" name="machine_name" id="machine_name" class="form-control" value="<%= machine.machine_name %>" required>
    </div>

    <div class="mb-3">
      <label for="file_name" class="form-label">Machine File</label>
      <% if(machine.file_name){ %>
        <p>Current File: <a href="/uploads/<%= machine.file_name %>" target="_blank"><%= machine.file_name %></a></p>
      <% } %>
      <input type="file" name="file_name" id="file_name" class="form-control">
      <!-- retain old file if not changed -->
      <input type="hidden" name="old_file" value="<%= machine.file_name %>">
    </div>

    <div class="mb-3">
      <label for="machine_status" class="form-label">Status</label>
      <select name="machine_status" id="machine_status" class="form-control" required>
        <option value="Active" <%= machine.machine_status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Inactive" <%= machine.machine_status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>

    <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Update Machine</button>
    <a href="/admin/machine_list" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to List</a>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
