<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit News Blog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Edit News Blog</h2>

      <div class="card violet-main">
        <div class="card-body">
        <form action="/admin/newsblog/edit/<%= blog.newsblog_id %>" method="POST" enctype="multipart/form-data">

            <div class="row g-3">
              
              <div class="col-12">
                <label class="form-label">Title</label>
                <input type="text" name="title" class="form-control" value="<%= blog.title %>" required>
              </div>

              <div class="col-12">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="6" required><%= blog.description %></textarea>
              </div>

              <div class="col-md-6">
                <label class="form-label">Date</label>
                <input type="date" name="date" class="form-control" value="<%= blog.date ? new Date(blog.date).toISOString().slice(0,10) : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label">Featured Image</label>
                <% if (blog.image) { %>
                  <div class="mb-2">
                    <img src="/uploads/<%= blog.image %>" alt="Blog Image" width="120" class="img-thumbnail">
                  </div>
                <% } %>
                <input type="file" name="image" class="form-control" accept="image/*">
                <input type="hidden" name="old_image" value="<%= blog.image %>">
                <small class="text-muted">Upload new image to replace existing.</small>
              </div>

              <div class="col-12 text-end">
                <a href="/admin/newsblog_list" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-violet">Save Changes</button>
              </div>

            </div>
          </form>
        </div>
      </div>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
