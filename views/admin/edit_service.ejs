<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Service</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Edit Service</h2>

      <div class="card violet-main">
        <div class="card-body">
          <form action="/admin/service/edit/<%= service.services_id %>" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label">Title</label>
                <input type="text" name="title" class="form-control" value="<%= service.title %>" required>
              </div>

              <div class="col-12">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="5" required><%= service.description %></textarea>
              </div>

              <div class="col-12">
                <label class="form-label">Current Image</label>
                <% if (service.image) { %>
                  <img src="/uploads/<%= service.image %>" style="max-width:300px; max-height:200px; object-fit:cover;">
                <% } else { %>
                  <div class="text-muted">No image uploaded</div>
                <% } %>
              </div>

              <div class="col-12">
                <label class="form-label">Replace Image (optional)</label>
                <input type="file" name="image" class="form-control" accept="image/*">
                <input type="hidden" name="old_image" value="<%= service.image || '' %>">
              </div>

              <div class="col-12 text-end">
                <a href="/admin/services" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-violet">Save Changes</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
