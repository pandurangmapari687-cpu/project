<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
  <style>
    .dashboard-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      transition: all 0.3s ease;
      height: 100%;
    }
    .dashboard-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    .card-icon {
      font-size: 3rem;
      margin-bottom: 15px;
    }
    .card-count {
      font-size: 2.5rem;
      font-weight: bold;
      margin: 15px 0;
    }
    .card-label {
      font-size: 1.1rem;
      color: #666;
      margin-bottom: 15px;
    }
    .card-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }
    .slider-card { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
    .service-card { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; }
    .machine-card { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; }
    .plants-card { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; }
    .workprocess-card { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: #333; }
    .btn-view {
      background: rgba(255,255,255,0.3);
      border: 2px solid rgba(255,255,255,0.5);
      color: white;
      padding: 8px 16px;
      border-radius: 6px;
      text-decoration: none;
      display: inline-block;
      transition: all 0.3s ease;
      font-size: 0.9rem;
    }
    .btn-view:hover {
      background: rgba(255,255,255,0.5);
      border-color: rgba(255,255,255,0.8);
      color: white;
    }
    .workprocess-card .btn-view {
      background: rgba(0,0,0,0.1);
      border-color: rgba(0,0,0,0.3);
      color: #333;
    }
    .workprocess-card .btn-view:hover {
      background: rgba(0,0,0,0.2);
      border-color: rgba(0,0,0,0.5);
    }
    .dashboard-header {
      background: linear-gradient(135deg, #5a0f9c 0%, #7c2bd6 100%);
      color: white;
      padding: 40px 20px;
      border-radius: 12px;
      margin-bottom: 40px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <div class="dashboard-header">
        <h1 class="mb-2">Welcome to Admin Dashboard</h1>
        <p class="mb-0">Manage all your content and resources</p>
      </div>

      <div class="row g-4">
        <!-- Slider Card -->
        <div class="col-md-6 col-lg-4">
          <a href="/admin/slider_list" class="card-link">
            <div class="card dashboard-card slider-card">
              <div class="card-body text-center">
                <div class="card-icon">
                  <i class="fas fa-images"></i>
                </div>
                <h5 class="card-label">Sliders</h5>
                <div class="card-count"><%= sliders || 0 %></div>
                <p class="mb-3">Manage slider images and content</p>
                <a href="/admin/slider_list" class="btn-view">View All →</a>
              </div>
            </div>
          </a>
        </div>

        <!-- Service Card -->
        <div class="col-md-6 col-lg-4">
          <a href="/admin/services" class="card-link">
            <div class="card dashboard-card service-card">
              <div class="card-body text-center">
                <div class="card-icon">
                  <i class="fas fa-cogs"></i>
                </div>
                <h5 class="card-label">Services</h5>
                <div class="card-count"><%= services || 0 %></div>
                <p class="mb-3">Manage your services</p>
                <a href="/admin/services" class="btn-view">View All →</a>
              </div>
            </div>
          </a>
        </div>

        <!-- Machine Card -->
        <div class="col-md-6 col-lg-4">
          <a href="/admin/machine_list" class="card-link">
            <div class="card dashboard-card machine-card">
              <div class="card-body text-center">
                <div class="card-icon">
                  <i class="fas fa-industry"></i>
                </div>
                <h5 class="card-label">Machines</h5>
                <div class="card-count"><%= machines || 0 %></div>
                <p class="mb-3">Manage machinery and equipment</p>
                <a href="/admin/machine_list" class="btn-view">View All →</a>
              </div>
            </div>
          </a>
        </div>

        <!-- Plants Card -->
        <div class="col-md-6 col-lg-4">
          <a href="/admin/plants_list" class="card-link">
            <div class="card dashboard-card plants-card">
              <div class="card-body text-center">
                <div class="card-icon">
                  <i class="fas fa-leaf"></i>
                </div>
                <h5 class="card-label">Plants</h5>
                <div class="card-count"><%= plants || 0 %></div>
                <p class="mb-3">Manage plants and nursery items</p>
                <a href="/admin/plants_list" class="btn-view">View All →</a>
              </div>
            </div>
          </a>
        </div>

        <!-- Working Process Card -->
        <div class="col-md-6 col-lg-4">
          <a href="/admin/workingprocess_list" class="card-link">
            <div class="card dashboard-card workprocess-card">
              <div class="card-body text-center">
                <div class="card-icon">
                  <i class="fas fa-tasks"></i>
                </div>
                <h5 class="card-label">Working Process</h5>
                <div class="card-count"><%= workingprocesses || 0 %></div>
                <p class="mb-3">Track working processes and steps</p>
                <a href="/admin/workingprocess_list" class="btn-view">View All →</a>
              </div>
            </div>
          </a>
        </div>

      </div>

    </main>
  </div>

  <!-- Bootstrap JS (bundle includes Popper) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
