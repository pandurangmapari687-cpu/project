<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Logged Out</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg,#f6f3fb,#fff); min-height:100vh; }
    .logout-card { max-width:520px; margin:100px auto; }
  </style>
</head>
<body>
  <main class="logout-card">
    <div class="card shadow-sm">
      <div class="card-body text-center">
        <h3 class="mb-2">You are logged out</h3>
        <p class="text-muted mb-4">You have successfully signed out of the admin panel.</p>

        <div class="d-flex justify-content-center gap-2">
          <a href="/admin/login" class="btn btn-violet">Sign in again</a>
          <a href="/" class="btn btn-outline-secondary">Go to site</a>
        </div>

        <div class="mt-4 small text-muted">If you need to remain logged out, close your browser window.</div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
