<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Machine List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <%- include('./navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4"><i class="fas fa-industry"></i> Machine List</h2>

    <div class="mb-3 text-end">
      <a href="/admin/machine" class="btn btn-violet"><i class="fas fa-plus"></i> Add New Machine</a>
    </div>

    <table class="table table-bordered table-striped align-middle machine-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Images</th>
          <th>Description</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (machines && machines.length > 0) { %>
          <% machines.forEach((machine, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= machine.machine_name || '—' %></td>
              <td>
                <div class="d-flex gap-2 flex-wrap">
                  <% const imgs = [machine.image1, machine.image2, machine.image3].filter(Boolean); %>
                  <% if (imgs.length > 0) { %>
                    <% imgs.forEach((fname, idx) => { %>
                      <a href="/uploads/<%= fname %>" target="_blank" title="<%= fname %>">
                        <img src="/uploads/<%= fname %>" 
                             alt="Machine image <%= idx + 1 %>" 
                             style="width:70px;height:50px;object-fit:cover;border-radius:6px;border:1px solid #dee2e6;">
                      </a>
                    <% }) %>
                  <% } else { %>
                    <span class="text-muted">No images</span>
                  <% } %>
                </div>
              </td>
              <td style="max-width:300px;white-space:normal;">
                <% const desc = (machine.description || '').toString().trim(); %>
                <% if (desc.length > 0) { %>
                  <%= desc.length > 120 ? desc.substring(0,120) + '...' : desc %>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td><span class="badge bg-info text-dark"><%= machine.machine_status %></span></td>
              <td>
                <a href="/admin/machine_edit/<%= machine.machine_id %>" class="btn btn-sm btn-violet-outline"><i class="fas fa-edit"></i></a>
                <a href="/admin/machine_delete/<%= machine.machine_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this machine?')"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center text-muted">No machines found</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</body>
</html>
