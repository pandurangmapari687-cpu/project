<!-- Font Awesome Icons -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<style>
  :root {
    --main-color: #ff5722;    /* Default icon color */
    --hover-color: #ff9800;   /* Hover/active color */
    --sidebar-bg: #2b2b3d;    /* Sidebar background */
  }

  /* Sidebar Styles */
  #adminSidebar {
    min-width: 220px;
    max-width: 220px;
    min-height: 100vh;
    background: var(--sidebar-bg);
    color: #fff;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
    transition: left 0.3s;
  }

  #adminSidebar .nav-link {
    color: #fff;
    border-radius: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    transition: 0.3s;
  }

  #adminSidebar .nav-link i {
    color: var(--main-color);
    transition: 0.3s;
    min-width: 20px;
    text-align: center;
  }

  #adminSidebar .nav-link.active,
  #adminSidebar .nav-link:hover {
    background: #3c3c50;
    color: var(--hover-color);
  }

  #adminSidebar .nav-link.active i,
  #adminSidebar .nav-link:hover i {
    color: var(--hover-color);
  }

  #adminContent {
    margin-left: 220px;
    padding: 2rem;
  }

  .submenu {
    list-style: none;
    padding-left: 30px;
  }

  .submenu .nav-link {
    font-size: 14px;
    padding: 6px 10px;
  }

  .sidebar-toggle {
    display: none;
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 200;
    font-size: 1.5rem;
    color: var(--main-color);
  }

  @media (max-width: 768px) {
    #adminSidebar { left: -220px; }
    #adminSidebar.active { left: 0; }
    #adminContent { margin-left: 0; }
    .sidebar-toggle { display: block; }
  }
</style>

<!-- Sidebar Toggle Button -->
