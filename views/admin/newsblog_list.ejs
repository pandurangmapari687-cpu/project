<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>News Blog List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">News Blog List</h2>

      <div class="mb-3 text-end">
        <a href="/admin/newblog" class="btn btn-violet">Add New Blog</a>
      </div>

      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Description</th>
              <th>Date</th>
              <th>Image</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (newsblogs && newsblogs.length) { %>
              <% newsblogs.forEach((blog, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= blog.title %></td>
                  <td><%= blog.description.length > 50 ? blog.description.substring(0,50) + '...' : blog.description %></td>
                  <td><%= blog.date ? new Date(blog.date).toISOString().slice(0,10) : '' %></td>
                  <td>
                    <% if (blog.image) { %>
                      <img src="/uploads/<%= blog.image %>" alt="Blog Image" width="80" class="img-thumbnail">
                    <% } %>
                  </td>
                  <td>
                    <a href="/admin/newsblog/edit/<%= blog.newsblog_id %>" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/admin/newsblog/delete/<%= blog.newsblog_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this blog?')">Delete</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center text-muted">No blogs found</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
