<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Service</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Add Service</h2>

      <div class="card violet-main">
        <div class="card-body">
          <form action="/admin/service" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label">Title</label>
                <input type="text" name="title" class="form-control" placeholder="Enter service title" required>
              </div>

              <div class="col-12">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="5" placeholder="Enter service description" required></textarea>
              </div>

              <div class="col-12">
                <label class="form-label">Service Image</label>
                <input type="file" name="image" class="form-control" accept="image/*">
              </div>

              <div class="col-12 text-end">
                <a href="/admin/services" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-violet">Add Service</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
