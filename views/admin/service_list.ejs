<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Services List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Services List</h2>

      <div class="mb-3">
        <a href="/admin/service" class="btn btn-violet"><i class="fas fa-plus"></i> Add New Service</a>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
          <thead style="background: linear-gradient(90deg,#5a0f9c, #7c2bd6); color: #fff;">
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Description</th>
              <th>Image</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (services && services.length > 0) { %>
              <% services.forEach((service, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= service.title %></td>
                  <td><%= service.description ? service.description.substring(0, 50) + '...' : 'N/A' %></td>
                  <td>
                    <% if (service.image) { %>
                      <img src="/uploads/<%= service.image %>" style="max-width:80px; max-height:60px; object-fit:cover;">
                    <% } else { %>
                      <span class="text-muted">No image</span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/admin/service/edit/<%= service.services_id %>" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/admin/service/delete/<%= service.services_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center text-muted">No services found</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
