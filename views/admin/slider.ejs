<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add New Slider</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Add New Slider</h2>

      <div class="card violet-main" style="max-width: 600px;">
        <div class="card-body">
          <form action="/admin/slider" method="POST" enctype="multipart/form-data">

            <div class="mb-3">
              <label class="form-label">Slider Title</label>
              <input type="text" name="title" class="form-control" placeholder="Enter slider title" required>
            </div>

            <div class="mb-3">
              <label class="form-label">Slider Image 1</label>
              <input type="file" name="image1" class="form-control" accept="image/*">
            </div>

            <div class="mb-3">
              <label class="form-label">Slider Image 2</label>
              <input type="file" name="image2" class="form-control" accept="image/*">
            </div>

            <div class="mb-3">
              <label class="form-label">Slider Image 3</label>
              <input type="file" name="image3" class="form-control" accept="image/*">
            </div>

            <div class="mb-3">
              <label class="form-label">Slider Image 4</label>
              <input type="file" name="image4" class="form-control" accept="image/*">
              <small class="text-muted">All images are optional. JPG, PNG, or GIF.</small>
            </div>

            <div class="d-flex gap-2">
              <a href="/admin/slider_list" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-violet">Save Slider</button>
            </div>

          </form>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
