<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Slider</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>

<div class="d-flex">
  <%- include('./navbar') %>

  <main class="flex-grow-1 p-4" style="margin-left:260px;">
    <h2 class="text-primary mb-4">Edit Slider</h2>

    <form action="/admin/slider/edit/<%= slider.id %>" method="POST">

      <div class="mb-3">
        <label class="form-label">Slider Title</label>
        <input type="text" name="title" class="form-control" value="<%= slider.title %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Current Image</label>
        <img src="/uploads/<%= slider.image %>" style="max-width:200px; border-radius:8px;">
      </div>

      <button class="btn btn-primary">Save Changes</button>
      <a href="/admin/slider_list" class="btn btn-secondary ms-2">Cancel</a>

    </form>
  </main>
</div>

</body>
</html>
