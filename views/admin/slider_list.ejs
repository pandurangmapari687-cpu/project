<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Slider List - Admin Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
  <link href="/css/admin.css" rel="stylesheet"/>

  <style>
    body { background: #f8f9fa; }
    .content-wrapper { margin-left: 260px; padding: 30px; }
    .table img { width: 100px; height: 60px; object-fit: cover; border-radius: 6px; margin-right:5px; }
    .btn-edit { background: #0d6efd; color: white; }
    .btn-delete { background: #dc3545; color: white; }
  </style>
</head>
<body>

<%- include('./navbar') %>

<div class="content-wrapper">
  <h1>Slider List</h1>

  <div class="mb-3">
    <a href="/admin/slider" class="btn btn-primary">
      <i class="fas fa-plus"></i> Add New Slider
    </a>
  </div>

  <table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Images (4)</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% if (sliders.length > 0) { %>
        <% sliders.forEach(slider => { %>
          <tr>
            <td><%= slider.slider_id %></td>
            <td><%= slider.title %></td>

            <!-- 4 Images -->
            <td>
              <% if (slider.image1) { %>
                <img src="/uploads/<%= slider.image1 %>" alt="img1">
              <% } %>

              <% if (slider.image2) { %>
                <img src="/uploads/<%= slider.image2 %>" alt="img2">
              <% } %>

              <% if (slider.image3) { %>
                <img src="/uploads/<%= slider.image3 %>" alt="img3">
              <% } %>

              <% if (slider.image4) { %>
                <img src="/uploads/<%= slider.image4 %>" alt="img4">
              <% } %>
            </td>

            <td>
              <a href="/admin/slider/edit/<%= slider.slider_id %>" class="btn btn-edit btn-sm me-2">
                <i class="fas fa-edit"></i> Edit
              </a>
              <a href="/admin/slider/delete/<%= slider.slider_id %>" class="btn btn-delete btn-sm">
                <i class="fas fa-trash"></i> Delete
              </a>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="4" class="text-center">No sliders available</td>
        </tr>
      <% } %>
    </tbody>

  </table>
</div>

</body>
</html>
