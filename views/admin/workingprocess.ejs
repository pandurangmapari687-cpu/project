<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Working Process Management</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Working Process Management</h2>

      <!-- Form to add a step -->
      <div class="card violet-main mb-4">
        <div class="card-body">
          <form action="/admin/workingprocess" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <!-- Optional Group Title -->
              <div class="col-12">
                <label class="form-label">Group Title (optional)</label>
                <input type="text" name="title" class="form-control" placeholder="Enter group title">
              </div>

              <!-- Single Step -->
              <div class="col-md-6">
                <label class="form-label">Step Name</label>
                <input type="text" name="name" class="form-control" placeholder="Enter step name">
              </div>
              <div class="col-md-6">
                <label class="form-label">Step Image</label>
                <input type="file" name="image" class="form-control" accept="image/*">
              </div>

              <div class="col-12 text-end">
                <button class="btn btn-violet">Add Process Step</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Existing Processes List -->
      <div class="card">
        <div class="card-body">
          <h4 class="mb-3">Existing Working Process Steps</h4>
          <% if (processes && processes.length > 0) { %>
            <div class="row g-3">
              <% processes.forEach((p, idx) => { %>
                <div class="col-md-6 col-lg-4">
                  <div class="card h-100">
                    <img src="/uploads/<%= p.image %>" class="card-img-top" alt="<%= p.name %>" style="height:180px; object-fit:cover;">
                    <div class="card-body">
                      <h5 class="card-title"><%= p.name %></h5>
                      <% if (p.title) { %>
                        <p class="card-text"><strong>Group:</strong> <%= p.title %></p>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-muted">No working process steps added yet.</p>
          <% } %>
        </div>
      </div>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
