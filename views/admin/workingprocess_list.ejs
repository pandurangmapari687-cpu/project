<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Working Process List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container py-5">
    <h2 class="mb-4">Working Processes</h2>

    <a href="/admin/workingprocess" class="btn btn-primary mb-3">Add New Process</a>

    <table class="table table-bordered">
      <thead>
        <tr>
          <th>ID</th>
          <th>Title</th>
          <th>Name</th>
          <th>Image</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% processes.forEach(p => { %>
          <tr>
            <td><%= p.workingprocess_id %></td>
            <td><%= p.title %></td>
            <td><%= p.name %></td>
            <td>
              <% if (p.image) { %>
                <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" width="80">
              <% } else { %>
                No Image
              <% } %>
            </td>
            <td>
              <a href="/admin/workingprocess/edit/<%= p.workingprocess_id %>" class="btn btn-sm btn-warning">Edit</a>
              <a href="/admin/workingprocess/delete/<%= p.workingprocess_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
