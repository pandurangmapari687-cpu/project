<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Working Process</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <%- include('./navbar') %>

    <main class="flex-grow-1 p-4" style="margin-left:260px;">
      <h2 class="mb-4">Edit Working Process</h2>

      <div class="card violet-main">
        <div class="card-body">
          <form action="/admin/workingprocess/edit/<%= process.id %>" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="old_image" value="<%= process.new_image || '' %>">

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Title</label>
                <input type="text" name="title" class="form-control" value="<%= process.title %>" required>
              </div>

              <div class="col-md-6">
                <label class="form-label">Image Name</label>
                <input type="text" name="image_name" class="form-control" value="<%= process.image_name %>">
              </div>

              <div class="col-12">
                <label class="form-label">Current Image</label>
                <% if (process.new_image) { %>
                  <div class="mb-2">
                    <img src="/uploads/<%= process.new_image %>" alt="<%= process.image_name %>" style="max-width: 300px; max-height: 200px; object-fit: cover; border-radius: 8px;">
                  </div>
                <% } else { %>
                  <div class="text-muted">No image uploaded</div>
                <% } %>
              </div>

              <div class="col-12">
                <label class="form-label">Replace Image (optional)</label>
                <input type="file" name="new_image" class="form-control" accept="image/*">
                <small class="text-muted">Leave empty to keep current image</small>
              </div>

              <div class="col-12 text-end">
                <a href="/admin/workingprocess_list" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-violet">Save Changes</button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
